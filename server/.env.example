# Server Configuration
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:3000

# JWT Configuration (Generate strong random key for production)
JWT_SECRET=your_strong_jwt_secret_key_here_min_32_chars
JWT_EXPIRE=7d

# Supabase Configuration
# ⚠️ NEVER commit .env with actual keys - use environment variables in production
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
SUPABASE_SECRET_KEY=your_secret_key_here_DO_NOT_EXPOSE
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# MongoDB (Optional - currently using Supabase)
# MONGODB_URI=mongodb://localhost:27017/shop
